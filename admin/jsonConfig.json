{
  "type": "tabs",
  "i18n": true,
  "items": {
    "source": {
      "type": "panel",
      "label": {
        "en": "External inverter",
        "de": "Fremd-WR"
      },
      "items": {
        "manufacturer": {
          "type": "select",
          "label": {
            "en": "Inverter manufacturer",
            "de": "Wechselrichter-Hersteller"
          },
          "options": [
            {
              "label": "Growatt (OpenAPI)",
              "value": "growatt",
              "icon": "data:image/png;base64,"
            },
            {
              "label": "Sungrow (soon)",
              "value": "sungrow"
            },
            {
              "label": "Huawei (soon)",
              "value": "huawei"
            },
            {
              "label": "Fronius (soon)",
              "value": "fronius"
            }
          ],
          "default": "growatt",
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "_hintSoon": {
          "type": "staticText",
          "text": {
            "en": "v1 supports Growatt only. Other manufacturers are placeholders.",
            "de": "v1 unterstützt nur Growatt. Andere Hersteller sind Platzhalter."
          },
          "xs": 12,
          "sm": 12,
          "md": 8
        },
        "growattFeedMode": {
          "type": "select",
          "label": {
            "en": "Data path",
            "de": "Datenweg"
          },
          "options": [
            {
              "label": {
                "en": "Cloud (OpenAPI)",
                "de": "Cloud (OpenAPI)"
              },
              "value": "cloud"
            },
            {
              "label": {
                "en": "Local (Stick realtime)",
                "de": "Lokal (Stick Echtzeit)"
              },
              "value": "local"
            }
          ],
          "default": "cloud",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "hidden": "data.manufacturer !== 'growatt'",
          "newLine": true
        },
        "_modeHint": {
          "type": "staticText",
          "text": {
            "en": "Cloud needs the OpenAPI token. Local needs Shine web login (user/password) only — no API token. Only the selected path is shown.",
            "de": "Cloud braucht den OpenAPI-Token. Lokal braucht nur Shine-Web-Login (User/Passwort) — kein API-Token. Es wird nur der gewählte Weg angezeigt."
          },
          "xs": 12,
          "sm": 12,
          "md": 8,
          "hidden": "data.manufacturer !== 'growatt'"
        },
        "_cloudHeader": {
          "type": "staticText",
          "format": "html",
          "text": "<div style=\"display:flex;align-items:center;gap:10px;background:#2196f3;color:#fff;padding:10px 14px;border-radius:4px;font-size:1.15rem;font-weight:600;line-height:1.2\"><img src=\"data:image/png;base64,\" alt=\"Growatt\" width=\"28\" height=\"28\" style=\"height:28px;width:28px;border-radius:4px;object-fit:contain;background:#000\"/><span>Growatt Cloud</span></div>",
          "xs": 12,
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'cloud'",
          "noTranslation": true
        },
        "growattToken": {
          "type": "password",
          "label": {
            "en": "API token (Shine OpenAPI)",
            "de": "API-Token (Shine OpenAPI)"
          },
          "xs": 12,
          "sm": 12,
          "md": 8,
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'cloud'",
          "help": {
            "en": "Only this is needed for cloud polling. Stored encrypted.",
            "de": "Nur das wird für Cloud-Polling gebraucht. Verschlüsselt gespeichert."
          }
        },
        "_searchHint": {
          "type": "staticText",
          "text": {
            "en": "Instance must be running. Search plants/devices, then enable those that feed the Fake SM (powers are summed).",
            "de": "Instanz muss laufen. Anlagen/Geräte suchen, dann per Haken wählen (Leistungen werden summiert)."
          },
          "xs": 12,
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'cloud'"
        },
        "discoverBtn": {
          "type": "sendTo",
          "label": {
            "en": "Search plants / devices",
            "de": "Anlagen / Geräte suchen"
          },
          "command": "discoverDevices",
          "jsonData": "{\"manufacturer\": \"${data.manufacturer}\"}",
          "useNative": true,
          "showProcess": true,
          "timeout": 120000,
          "variant": "contained",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'cloud'"
        },
        "devices": {
          "type": "table",
          "label": {
            "en": "Devices for Fake SM",
            "de": "Geräte für Fake-SM"
          },
          "xs": 12,
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'cloud'",
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": {
                "en": "Use",
                "de": "Nutzen"
              },
              "default": false,
              "width": 60
            },
            {
              "type": "text",
              "attr": "plantName",
              "title": {
                "en": "Plant",
                "de": "Anlage"
              },
              "readOnly": true
            },
            {
              "type": "text",
              "attr": "plantId",
              "title": {
                "en": "Plant ID",
                "de": "Plant-ID"
              },
              "readOnly": true,
              "width": 100
            },
            {
              "type": "text",
              "attr": "deviceSn",
              "title": {
                "en": "Device SN",
                "de": "Geräte-SN"
              },
              "readOnly": true
            },
            {
              "type": "text",
              "attr": "deviceType",
              "title": {
                "en": "Type",
                "de": "Typ"
              },
              "width": 80
            },
            {
              "type": "text",
              "attr": "model",
              "title": {
                "en": "Model",
                "de": "Modell"
              },
              "readOnly": true
            },
            {
              "type": "number",
              "attr": "eBaselineKwh",
              "title": {
                "en": "eBaseline (kWh)",
                "de": "eBaseline (kWh)"
              },
              "readOnly": true,
              "width": 110
            },
            {
              "type": "checkbox",
              "attr": "eBaselineLocked",
              "title": {
                "en": "Locked",
                "de": "Gesperrt"
              },
              "default": false,
              "readOnly": true,
              "width": 70
            }
          ]
        },
        "cloudExpertSettings": {
          "type": "panel",
          "label": {
            "en": "Expert: source (Growatt OpenAPI)",
            "de": "Experten: Quelle (Growatt OpenAPI)"
          },
          "collapsable": true,
          "xs": 12,
          "items": {
            "_cloudExpertHint": {
              "type": "staticText",
              "text": {
                "en": "Applies to all enabled Growatt devices (powers are summed). Not per device.",
                "de": "Gilt für alle angehakten Growatt-Geräte (Leistungen werden summiert). Nicht pro Gerät."
              },
              "xs": 12
            },
            "powerFields": {
              "type": "text",
              "label": {
                "en": "Power fields (comma-separated priority)",
                "de": "Leistungsfelder (Komma, Priorität)"
              },
              "default": "ppv,pac,outPower,powerOfPhotovoltaic,chargePower",
              "xs": 12,
              "sm": 12,
              "md": 8
            },
            "powerSign": {
              "type": "number",
              "label": {
                "en": "Power sign (Location 3 feed-in usually -1)",
                "de": "Leistungsvorzeichen (Location 3 meist -1)"
              },
              "default": -1,
              "xs": 12,
              "sm": 6,
              "md": 4
            },
            "powerKwThreshold": {
              "type": "number",
              "label": {
                "en": "Treat values below as kW (0=off)",
                "de": "Werte darunter als kW (0=aus)"
              },
              "default": 0,
              "xs": 12,
              "sm": 6,
              "md": 4
            }
          },
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'cloud'"
        },
        "_localHeader": {
          "type": "header",
          "text": {
            "en": "Local setup",
            "de": "Lokal-Einrichtung"
          },
          "size": 2,
          "xs": 12,
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local'"
        },
        "_localIntro": {
          "type": "staticText",
          "text": {
            "en": "Redirect stick here for realtime; forward keeps Growatt cloud active. Setup needs the stick online at Growatt (often unavailable at night).",
            "de": "Stick hierher umleiten für Echtzeit; Weiterleiten hält die Growatt-Cloud aktiv. Einrichtung braucht den Stick online bei Growatt (nachts oft weg)."
          },
          "xs": 12,
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local'"
        },
        "_localCreds": {
          "type": "header",
          "text": {
            "en": "1. Login",
            "de": "1. Login"
          },
          "size": 2,
          "xs": 12,
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local'"
        },
        "growattUser": {
          "type": "text",
          "label": {
            "en": "Shine web user",
            "de": "Shine-Web-User"
          },
          "help": {
            "en": "Same as server.growatt.com. Stored encrypted.",
            "de": "Wie server.growatt.com. Verschlüsselt gespeichert."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local'"
        },
        "growattPassword": {
          "type": "password",
          "label": {
            "en": "Shine web password",
            "de": "Shine-Web-Passwort"
          },
          "help": {
            "en": "Stored encrypted.",
            "de": "Verschlüsselt gespeichert."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local'"
        },
        "_onlineHeader": {
          "type": "header",
          "text": {
            "en": "2. Online status",
            "de": "2. Online-Status"
          },
          "size": 2,
          "xs": 12,
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local'"
        },
        "_statusOnlineGlow": {
          "type": "staticText",
          "text": "WR verbunden",
          "style": {
            "fontSize": "1.25rem",
            "fontWeight": 700,
            "letterSpacing": "0.02em",
            "color": "#00c853",
            "textShadow": "0 0 2px rgba(0,200,83,0.45)",
            "padding": "10px 0"
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "hidden": "(data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local') || (!data.stickCloudOnline)"
        },
        "_statusOfflineGlow": {
          "type": "staticText",
          "text": "WR nicht verbunden",
          "style": {
            "fontSize": "1.25rem",
            "fontWeight": 700,
            "letterSpacing": "0.02em",
            "color": "#d50000",
            "textShadow": "0 0 2px rgba(213,0,0,0.4)",
            "padding": "10px 0"
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "hidden": "(data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local') || (data.stickCloudOnline)"
        },
        "checkStickOnlineBtn": {
          "type": "sendTo",
          "label": {
            "en": "Check manually",
            "de": "Manuell prüfen"
          },
          "icon": "refresh",
          "command": "checkStickOnline",
          "jsonData": "{}",
          "useNative": true,
          "showProcess": true,
          "timeout": 90000,
          "variant": "outlined",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local'"
        },
        "_statusNightHint": {
          "type": "staticText",
          "text": {
            "en": "Note: At night or in low light the inverter powers down — Growatt then has no live link to the stick, so remote setup is not possible. Wait until status is green (daylight), then run setup.",
            "de": "Hinweis: Nachts oder bei zu wenig Licht schaltet sich der Wechselrichter ab — Growatt hat dann keine Live-Verbindung zum Stick, eine Einrichtung ist nicht möglich. Warten, bis der Status grün ist (Tageslicht), dann einrichten."
          },
          "style": {
            "opacity": 0.85,
            "paddingBottom": "8px"
          },
          "xs": 12,
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local'"
        },
        "stickOnlineLabel": {
          "type": "text",
          "label": "label",
          "default": "WR nicht verbunden",
          "readOnly": true,
          "hidden": true,
          "xs": 12
        },
        "stickCloudOnline": {
          "type": "checkbox",
          "label": "online",
          "default": false,
          "readOnly": true,
          "hidden": true,
          "xs": 12
        },
        "localSetupVerified": {
          "type": "checkbox",
          "label": "verified",
          "default": false,
          "readOnly": true,
          "hidden": true,
          "xs": 12
        },
        "_setupHeader": {
          "type": "header",
          "text": {
            "en": "3. Setup",
            "de": "3. Einrichtung"
          },
          "size": 2,
          "xs": 12,
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local'"
        },
        "_setupBlocked": {
          "type": "staticText",
          "text": {
            "en": "„Setup stick“ is available when status is green. If it stays red: often night/low light — try again in daylight.",
            "de": "„Stick einrichten“ ist verfügbar, sobald der Status grün ist. Bleibt er rot: oft Nacht/zu wenig Licht — bei Tageslicht erneut versuchen."
          },
          "xs": 12,
          "hidden": "(data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local') || (data.stickCloudOnline)"
        },
        "setupLocalStickBtn": {
          "type": "sendTo",
          "label": {
            "en": "Setup stick",
            "de": "Stick einrichten"
          },
          "command": "setupLocalStick",
          "jsonData": "{}",
          "useNative": true,
          "showProcess": true,
          "timeout": 180000,
          "variant": "contained",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "hidden": "(data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local') || (!data.stickCloudOnline)"
        },
        "_localModeHeader": {
          "type": "header",
          "text": {
            "en": "4. Local connection",
            "de": "4. Lokale Verbindung"
          },
          "size": 2,
          "xs": 12,
          "hidden": "(data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local') || (!data.localSetupVerified)"
        },
        "_localModeBlocked": {
          "type": "staticText",
          "text": {
            "en": "The switch appears only after stick setup and a successful local connection test.",
            "de": "Der Schalter erscheint erst, wenn der Stick eingerichtet ist und der Adapter eine lokale Verbindung bestätigt hat."
          },
          "xs": 12,
          "hidden": "(data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local') || (data.localSetupVerified)"
        },
        "localEnabled": {
          "type": "checkbox",
          "label": "localEnabled",
          "default": false,
          "hidden": true,
          "xs": 12
        },
        "_localEnabledSwitch": {
          "type": "state",
          "oid": "info.localEnabled",
          "control": "switch",
          "label": {
            "en": "Local connection active",
            "de": "Lokale Verbindung aktiv"
          },
          "trueText": {
            "en": "On",
            "de": "An"
          },
          "falseText": {
            "en": "Off",
            "de": "Aus"
          },
          "help": {
            "en": "Auto-on after successful setup. You can always turn it off; turn on only after verified setup.",
            "de": "Nach erfolgreicher Einrichtung automatisch an. Immer manuell aus; an nur nach bestätigter Einrichtung."
          },
          "xs": 12,
          "sm": 12,
          "md": 6,
          "hidden": "(data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local') || (!data.localSetupVerified)"
        },
        "localExpertSettings": {
          "type": "panel",
          "label": {
            "en": "Expert: local stick / proxy",
            "de": "Experten: lokaler Stick / Proxy"
          },
          "collapsable": true,
          "xs": 12,
          "items": {
            "localStickSn": {
              "type": "text",
              "label": {
                "en": "Stick / datalogger SN",
                "de": "Stick- / Datalogger-SN"
              },
              "xs": 12,
              "sm": 6,
              "md": 4
            },
            "advertisedModbusIp": {
              "type": "text",
              "label": {
                "en": "This host IP (for stick server)",
                "de": "Diese Host-IP (Stick-Server)"
              },
              "readOnly": true,
              "xs": 12,
              "sm": 6,
              "md": 4
            },
            "localForwardCloud": {
              "type": "checkbox",
              "label": {
                "en": "Forward stick traffic to Growatt cloud",
                "de": "Stick-Traffic an Growatt-Cloud weiterleiten"
              },
              "default": true,
              "xs": 12,
              "sm": 6,
              "md": 4
            },
            "localPort": {
              "type": "number",
              "label": {
                "en": "Local listen port",
                "de": "Lokaler Listen-Port"
              },
              "default": 5279,
              "xs": 12,
              "sm": 6,
              "md": 3
            },
            "localUpstreamHost": {
              "type": "text",
              "label": {
                "en": "Upstream IP override (empty = auto)",
                "de": "Upstream-IP Override (leer = auto)"
              },
              "default": "",
              "xs": 12,
              "sm": 6,
              "md": 4
            },
            "stickStatusText": {
              "type": "text",
              "label": {
                "en": "Last status detail",
                "de": "Letztes Status-Detail"
              },
              "readOnly": true,
              "xs": 12
            }
          },
          "hidden": "data.manufacturer !== 'growatt' || data.growattFeedMode !== 'local'"
        }
      }
    },
    "meter": {
      "type": "panel",
      "label": {
        "en": "Modbus / Fronius",
        "de": "Modbus / Fronius"
      },
      "items": {
        "_gen24Header": {
          "type": "header",
          "text": {
            "en": "Add Fake Smart Meter on Gen24",
            "de": "Fake Smart Meter am Gen24 hinzufügen"
          },
          "size": 2,
          "xs": 12
        },
        "_gen24Setup": {
          "type": "staticText",
          "text": {
            "en": "Technician login required (Customer cannot add meters). On the Gen24 web UI: Device configuration → Components → Add component. Type: Fronius Smart Meter (TCP). IP = ioBroker IP below, Port 502, Modbus address = same as here (default 3, never 1 = primary). Application: Producer meter (Erzeugerzähler), Category: Inverter; leave the rest default. Then search Fronius below so this adapter knows the master.",
            "de": "Techniker-Login nötig (Endkunde kann keine Zähler anlegen). Am Gen24: Gerätekonfiguration → Komponenten → Komponente hinzufügen. Typ: Fronius Smart Meter (TCP). IP = ioBroker-IP unten, Port 502, Modbus-Adresse = wie hier (Default 3, nie 1 = Primär). Anwendung: Erzeugerzähler, Kategorie: Wechselrichter; Rest Standard. Danach unten Fronius suchen, damit der Adapter den Master kennt."
          },
          "xs": 12
        },
        "_froniusScan": {
          "type": "header",
          "text": {
            "en": "Fronius master (network search)",
            "de": "Fronius-Master (Netzwerksuche)"
          },
          "size": 2,
          "xs": 12
        },
        "_froniusHint": {
          "type": "staticText",
          "text": {
            "en": "Select the inverter that already reports meters (master / primary SM). Search auto-picks the device with the highest meter count.",
            "de": "Den Wechselrichter mit gemeldeten Zählern wählen (Master / Primär-SM). Die Suche wählt automatisch den mit der höchsten Zähleranzahl."
          },
          "xs": 12
        },
        "discoverFroniusBtn": {
          "type": "sendTo",
          "label": {
            "en": "Search Fronius on network",
            "de": "Fronius im Netzwerk suchen"
          },
          "command": "discoverFronius",
          "jsonData": "{}",
          "useNative": true,
          "showProcess": true,
          "timeout": 180000,
          "variant": "contained",
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "froniusDevices": {
          "type": "table",
          "label": {
            "en": "Found Fronius inverters (enable master)",
            "de": "Gefundene Fronius-WR (Master anhaken)"
          },
          "xs": 12,
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": {
                "en": "Use",
                "de": "Nutzen"
              },
              "default": false,
              "width": 60
            },
            {
              "type": "text",
              "attr": "ip",
              "title": "IP",
              "readOnly": true,
              "width": 120
            },
            {
              "type": "text",
              "attr": "hostname",
              "title": {
                "en": "Hostname",
                "de": "Hostname"
              },
              "readOnly": true
            },
            {
              "type": "text",
              "attr": "serial",
              "title": "SN",
              "readOnly": true
            },
            {
              "type": "text",
              "attr": "model",
              "title": {
                "en": "Model",
                "de": "Modell"
              },
              "readOnly": true
            },
            {
              "type": "text",
              "attr": "existingMeters",
              "title": {
                "en": "Meters",
                "de": "Zähler"
              },
              "readOnly": true,
              "width": 140
            }
          ]
        },
        "advertisedModbusIp": {
          "type": "text",
          "label": {
            "en": "ioBroker IP (for Gen24)",
            "de": "ioBroker-IP (für Gen24)"
          },
          "help": {
            "en": "Always this host’s LAN IP. Enter it on Gen24 when adding the Modbus component.",
            "de": "Immer die LAN-IP dieses Hosts. Am Gen24 beim Hinzufügen der Modbus-Komponente eintragen."
          },
          "readOnly": true,
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "modbusUnitId": {
          "type": "number",
          "label": {
            "en": "Modbus address (Gen24 secondary)",
            "de": "Modbus-Adresse (Gen24 Sekundär)"
          },
          "help": {
            "en": "Same as Gen24 Modbus address. Default 3; change if already used. Never 1 (primary).",
            "de": "Gleicher Wert wie Gen24 Modbus-Adresse. Default 3; ändern wenn belegt. Nie 1 (Primär)."
          },
          "default": 3,
          "min": 2,
          "max": 127,
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "expertSettings": {
          "type": "panel",
          "label": {
            "en": "Expert settings",
            "de": "Experten-Einstellung"
          },
          "collapsable": true,
          "xs": 12,
          "items": {
            "_expertScopeHint": {
              "type": "staticText",
              "text": {
                "en": "All values are instance-wide (not per source device). Multiple Growatt devices are summed first, then smoothed into one Fake SM.",
                "de": "Alles gilt instanzweit (nicht pro Quell-Gerät). Mehrere Growatt-Geräte werden zuerst summiert, dann zu einem Fake-SM geglättet."
              },
              "xs": 12
            },
            "_srcPollHeader": {
              "type": "header",
              "text": {
                "en": "Source fetch (cloud)",
                "de": "Quelle Abruf (Cloud)"
