{
  "common": {
    "name": "fronius-fake-sm",
    "version": "0.5.55",
    "news": {
      "0.5.55": {
        "en": "Local multi-stick: per-SN redirect registry; stick list without plant filter; patch/remove per selected stick",
        "de": "Lokal Multi-Stick: Umleitungs-Register pro SN; Stick-Liste ohne Anlagen-Filter; Patchen/Entfernen pro gewähltem Stick"
      },
      "0.5.54": {
        "en": "Gen24 Fake-SM visibility health; Modbus client state; isolate lab stick from feed path",
        "de": "Gen24 Fake-SM Sichtbarkeits-Health; Modbus-Client-State; Lab-Stick vom Feed-Pfad isolieren"
      },
      "0.5.53": {
        "en": "WR vars: family filter, orphan prune, holding readback, write ack feedback, clock setting",
        "de": "WR-Vars: Familienfilter, Orphan-Prune, Holding-Readback, Write-Ack-Feedback, Uhr-Setting"
      },
      "0.5.52": {
        "en": "Selectable inverter variables as datapoints (read+safe write); cloud/local sample rates",
        "de": "Wählbare WR-Variablen als Datenpunkte (Lesen+sicheres Schreiben); Cloud/Lokal Sample-Rates"
      },
      "0.5.51": {
        "en": "FW 3.1.1.7 AES session KDF from 0x41 handshake; attempt local AES-CBC decrypt",
        "de": "FW 3.1.1.7 AES-Session-KDF aus 0x41-Handshake; lokaler AES-CBC-Decrypt-Versuch"
      },
      "0.5.50": {
        "en": "Single stick session (drop zombies); unknown-FW frame health warning; proxyClientCount",
        "de": "Eine Stick-Session (Zombies verwerfen); Warnung bei unbekannter FW; proxyClientCount"
      },
      "0.5.49": {
        "en": "dropProxyClients sendTo for handshake capture; no boot native write for pending",
        "de": "dropProxyClients sendTo für Handshake-Capture; kein Boot-Native-Write für pending"
      },
      "0.5.48": {
        "en": "Do not persist localSetupPending on boot (avoids restart loop during frame capture)",
        "de": "localSetupPending beim Boot nicht persistieren (kein Restart-Loop während Frame-Capture)"
      },
      "0.5.47": {
        "en": "Proxy always on by default; unified live stick status; frame capture for FW 3.1.1.7 analysis",
        "de": "Proxy standardmäßig immer aktiv; einheitlicher Live-Stick-Status; Frame-Capture für FW-3.1.1.7-Analyse"
      },
      "0.5.46": {
        "en": "Fix stick lockout: proxy stays up while a redirect is known, Remove-redirect verifies the stick left the proxy before clearing flags",
        "de": "Behebt Stick-Aussperrung: Proxy bleibt aktiv solange eine Umleitung bekannt ist, Umleitung-entfernen prüft vor dem Zurücksetzen, dass der Stick den Proxy verlassen hat"
      },
      "0.5.45": {
        "en": "Document supported Growatt sticks (Wifi-X / Lan-X) and Gen24-only Fronius target",
        "de": "Dokumentiert unterstützte Growatt-Sticks (Wifi-X / Lan-X) und Fronius-Ziel nur Gen24"
      },
      "0.5.44": {
        "en": "Local steps as bordered tiles (label/status/action grouped per row)",
        "de": "Lokale Schritte als Kacheln mit Rahmen (Label/Status/Aktion pro Zeile gruppiert)"
      },
      "0.5.43": {
        "en": "info.localEnabled read-only (auto from verified; no Objects switch)",
        "de": "info.localEnabled nur lesbar (automatisch aus verified; kein Objects-Schalter)"
      },
      "0.5.42": {
        "en": "Refresh Shine status after connect; night hint under step 3",
        "de": "Shine-Status nach Cloud-Verbinden aktualisieren; Nacht-Hinweis unter Schritt 3"
      },
      "0.5.41": {
        "en": "Local 5-step workflow; OpenAPI bridge until stick connected; auto local feed without switch",
        "de": "Lokal 5-Schritte-Workflow; OpenAPI-Übergang bis Stick verbunden; lokal automatisch ohne Schalter"
      },
      "0.5.40": {
        "en": "Local workflow overview: why/what, status board (setup/connection/feed), next-step hints",
        "de": "Lokal-Workflow-Überblick: Wozu/Was, Status-Board (Einrichtung/Verbindung/Feed), Als-Nächstes"
      },
      "0.5.39": {
        "en": "Setup unlock requires Growatt remote command (not Shine list alone) — fixes green badge vs setup error",
        "de": "Setup nur bei Remote-Befehl (nicht nur Shine-Liste) — behebt grünes Badge vs. Setup-Fehler"
      },
      "0.5.38": {
        "en": "Restore button on cloud path; block ambiguous NIC setup; orphan-safe sanitize; network hint state",
        "de": "Restore-Button bei Cloud-Pfad; Setup bei Mehrdeutigkeit blockieren; Sanitize ohne Orphan; Netzwerk-Hinweis-State"
      },
      "0.5.37": {
        "en": "Explain/restore local stick setup; network IP preflight; clear verified on cloud mode",
        "de": "Lokal-Setup erklären/rückgängig; Netzwerk-IP-Preflight; Verified bei Cloud-Modus löschen"
      },
      "0.5.36": {
        "en": "Stick setup no longer writes native mid-redirect (fixes DB closed / aborted setup)",
        "de": "Stick-Einrichtung schreibt Native nicht mehr mitten im Redirect (behebt DB closed / abgebrochenes Setup)"
      }
    },
    "titleLang": {
      "en": "Fronius Fake Smart Meter",
      "de": "Fronius Fake Smart Meter"
    },
    "desc": {
      "en": "Fake Fronius Smart Meter (Modbus TCP) for Gen24 secondary / producer meter. Growatt OpenAPI cloud, optional local ShineWiFi-X proxy (:5279).",
      "de": "Fake Fronius Smart Meter (Modbus TCP) für Gen24-Sekundär-/Erzeugerzähler. Growatt-OpenAPI-Cloud, optional lokaler ShineWiFi-X-Proxy (:5279)."
    },
