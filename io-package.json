{
  "common": {
    "name": "fronius-fake-sm",
    "version": "0.5.32",
    "news": {
      "0.5.32": {
        "en": "Skip Gen24 native persist when lastPublished unchanged (stops restart loop)",
        "de": "Kein Gen24-Native-Persist wenn lastPublished unverändert (stoppt Restart-Loop)"
      },
      "0.5.31": {
        "en": "Gap fix: keep Gen24 baselines on restart; lastPublished←relSum fail-safe; tests",
        "de": "Gap-Fix: Gen24-Baselines beim Restart behalten; lastPublished←relSum Fail-safe; Tests"
      },
      "0.5.30": {
        "en": "Never adopt Gen24 0 kWh as truth when a prior Fake-SM counter exists",
        "de": "Gen24 0 kWh nie als Truth übernehmen, wenn ein früherer Fake-SM-Zähler existiert"
      },
      "0.5.29": {
        "en": "Ignore Gen24 transient 0 kWh after Modbus reconnect; require stable Loc3 reading",
        "de": "Ignoriert Gen24-Transient 0 kWh nach Modbus-Reconnect; stabile Loc3-Lesung nötig"
      },
      "0.5.28": {
        "en": "Wait for Gen24 Modbus client before Solar-API energy truth seed",
        "de": "Wartet auf Gen24-Modbus-Client vor Solar-API-Energie-Truth-Seed"
      },
      "0.5.27": {
        "en": "Gen24 truth seed after Modbus up + retries (Loc3 may drop during restart)",
        "de": "Gen24-Truth-Seed nach Modbus-Start + Retries (Loc3 kann beim Restart kurz fehlen)"
      },
      "0.5.26": {
        "en": "On every start: seed Fake-SM energy from Gen24 Solar API (Location meter truth)",
        "de": "Bei jedem Start: Fake-SM-Energie vom Gen24 Solar-API-Zähler (Location) seeden"
      },
      "0.5.25": {
        "en": "Fix lastPublished: Number(null) must not seed eProduced at 0",
        "de": "Fix lastPublished: Number(null) darf eProduced nicht mit 0 seeden"
      },
      "0.5.24": {
        "en": "Auto eTotal baselines per device + lastPublished continuity (fail-safe vs Fronius jumps)",
        "de": "Auto-eTotal-Baselines pro Gerät + lastPublished-Kontinuität (Fail-safe gegen Fronius-Sprünge)"
      },
      "0.5.23": {
        "en": "Expert UI split: source fetch / pipeline / Fake SM; clearer eTotal offset help",
        "de": "Experten-UI: Quelle Abruf / Pipeline / Fake-SM; klarere eTotal-Offset-Hilfe"
      },
      "0.5.22": {
        "en": "Growatt Cloud header with small logo",
        "de": "Growatt Cloud Header mit kleinem Logo"
      },
      "0.5.21": {
        "en": "Growatt Cloud header + fixed dropdown icon (base64)",
        "de": "Growatt-Cloud-Header + Dropdown-Icon per Base64 repariert"
      },
      "0.5.20": {
        "en": "Remove oversized Growatt static images; keep select icon only",
        "de": "Übergroße Growatt-Bilder entfernt; nur Select-Icon behalten"
      },
      "0.5.19": {
        "en": "Growatt manufacturer icon in admin selection",
        "de": "Growatt-Hersteller-Icon in der Admin-Auswahl"
      },
      "0.5.18": {
        "en": "Updated adapter icon",
        "de": "Aktualisiertes Adapter-Icon"
      },
      "0.5.17": {
        "en": "New adapter icon (Fronius chart/sun)",
        "de": "Neues Adapter-Icon (Fronius Chart/Sonne)"
      },
      "0.5.16": {
        "en": "Local calibrate: one-shot OpenAPI truth + seed retry until lock",
        "de": "Lokal-Calibrate: OpenAPI-Truth einmalig + Seed-Retry bis Lock"
      },
      "0.5.15": {
        "en": "Keep rate-limit cooldown after partial poll; preserve Modbus port on discover",
        "de": "Rate-Limit-Cooldown nach Teilsample behalten; Modbus-Port bei Discover erhalten"
      },
      "0.5.14": {
        "en": "Audit fixes: local seed calibrate, proxy lifecycle, stale→0 W, Shine HTML≠online",
        "de": "Audit-Fixes: Lokal-Seed-Calibrate, Proxy-Lifecycle, stale→0 W, Shine HTML≠online"
      }
    },
    "titleLang": {
      "en": "Fronius Fake Smart Meter",
      "de": "Fronius Fake Smart Meter"
    },
    "desc": {
      "en": "Serves a Fake Fronius Smart Meter (Modbus TCP) from Growatt cloud and optional local stick proxy.",
      "de": "Stellt einen Fake Fronius Smart Meter (Modbus TCP) aus Growatt-Cloud und optional lokalem Stick-Proxy bereit."
    },
    "authors": [
      "Passuff"
